{
    "name": "moinul-techlab/monitoring-agent",
    "description": "One middleware that logs request timing/status into a table, and a cached endpoint to read it back — built for polling dashboards.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/bus": "^10.0|^11.0|^12.0",
        "illuminate/queue": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Mtl\\RequestTracker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mtl\\RequestTracker\\RequestTrackerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}