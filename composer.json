{
    "name": "mtlm/monitoring-agent",
    "description": "Laravel server monitoring agent for collecting request performance, status, memory, and endpoint metrics.",
    "license": "MIT",
    "homepage": "https://github.com/mtlm/monitoring-agent",
    "support": {
        "issues": "https://github.com/mtlm/monitoring-agent/issues",
        "source": "https://github.com/mtlm/monitoring-agent"
    },
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/bus": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Mtl\\MonitorlyAgent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mtl\\MonitorlyAgent\\MonitorlyAgentServiceProvider"
            ]
        }
    },
    "keywords": [
        "laravel",
        "monitoring",
        "server-monitoring",
        "request-monitoring",
        "uptime",
        "performance",
        "metrics",
        "api-monitoring",
        "request-tracker",
        "mtl-monitoring-agent"
    ],
    "authors": [
        {
            "name": "Moinul Tech Lab",
            "homepage": "https://github.com/moinul70"
        }
    ]
}